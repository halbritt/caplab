BOUNDARY_RE = re.compile(
    r"^(?:foreword(?:\s*[:.\-–—]\s*.*)?|"
    r"preface(?:\s*[:.\-–—]\s*.*)?|"
    r"afterword(?:\s*[:.\-–—]\s*.*)?|acknowledg(?:e)?ments?|"
    r"introduction(?:\s*[:.\-–—]\s*.*)?|"
    r"prologue(?:\s*[:.\-–—]\s*.*)?|"
    r"epilogue(?:\s*[:.\-–—]\s*.*)?|contents|table of contents|"
    r"about (?:the )?authors?|"
    r"chapter\s+\d+\b.*|part\s+"
    r"(?:\d+|[ivxlcdm]+)\b.*|appendix(?:\s+[a-z0-9]+)?\b.*|"
    r"self-assessment questions|references|bibliography|glossary|index|"
    r"endnotes|colophon)$",
    re.IGNORECASE,
)
STRONG_NAMED_BOUNDARY_RE = re.compile(
    r"^(?:foreword(?:\s*[:.\-–—]\s*.*)?|"
    r"preface(?:\s*[:.\-–—]\s*.*)?|afterword(?:\s*[:.\-–—]\s*.*)?|"
    r"epilogue(?:\s*[:.\-–—]\s*.*)?|"
    r"acknowledg(?:e)?ments?|about (?:the )?authors?|references|"
    r"bibliography|glossary|index|endnotes|colophon)$",
    re.IGNORECASE,
)
HEADING_RE = re.compile(r"^(#{1,6})[ \t]+(.+?)[ \t]*#*[ \t]*$")
FENCE_OPEN_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
LINK_RE = re.compile(r"((?<![A-Za-z0-9_])!?\[[^\]]*\]\()([^\n)]+)(\))")
HTML_LINK_RE = re.compile(r"(\b(?:src|href)=[\"'])([^\"']+)([\"'])", re.IGNORECASE)
HTML_ANCHOR_RE = re.compile(
    r"<a\b[^>]*\bhref=[\"']([^\"']+)[\"'][^>]*>([^<]*)</a>", re.IGNORECASE
)
TERMINAL_ESCAPE_RE = re.compile(
    r"\x1B(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1B]*(?:\x07|\x1B\\)|[@-_])"
)
NON_MARKDOWN_CONTROL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
HTML_ID_RE = re.compile(r"\b(?:id|name)=[\"']([^\"']+)[\"']", re.IGNORECASE)
EMPTY_ANCHOR_TAG_RE = re.compile(
    r"<(?:span|a)\b[^>]*(?:id|name)=[\"'][^\"']+[\"'][^>]*>\s*</(?:span|a)>",
    re.IGNORECASE,
)
INFRASTRUCTURE_FAILURE_RE = re.compile(
    r"(?:connection (?:refused|timed out|closed)|could not resolve hostname|"
    r"name or service not known|no route to host|network is unreachable|"
    r"permission denied \(publickey|marker: upload failed|marker: download failed|"
    r"no live .marker. slot|ssh:|scp:|cuda out of memory|outofmemoryerror|"
    r"no such file or directory|command not found|is not recognized as an internal)",
    re.IGNORECASE,
)
