class BookConversionError(RuntimeError):
    pass


def json_bytes(value: object) -> bytes:
    return (
        json.dumps(value, indent=2, ensure_ascii=False, sort_keys=True) + "\n"
    ).encode("utf-8")


def write_json(path: Path, value: object) -> None:
    path.write_bytes(json_bytes(value))


def atomic_write(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.tmp-", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fingerprint_value(value: object) -> object:
    if value is None or isinstance(value, (bool, int, float, str)):
        return value
    if isinstance(value, Path):
        return value.as_posix()
    if isinstance(value, re.Pattern):
        return {"pattern": value.pattern, "flags": value.flags}
    if isinstance(value, dict):
        return [
            [fingerprint_value(key), fingerprint_value(entry)]
            for key, entry in sorted(value.items(), key=lambda pair: repr(pair[0]))
        ]
    if isinstance(value, (list, tuple)):
        return [fingerprint_value(entry) for entry in value]
    if isinstance(value, (set, frozenset)):
        entries = [fingerprint_value(entry) for entry in value]
        return sorted(entries, key=lambda entry: json.dumps(entry, sort_keys=True))
    return repr(value)


def raw_stage_implementation_fingerprint(*roots: object) -> str:
    """Hash raw-conversion code and its repository-local dependencies."""
    pending = list(roots)
    visited: set[int] = set()
    components: dict[str, object] = {}
    while pending:
        component = pending.pop()
        if id(component) in visited:
            continue
        visited.add(id(component))
        qualified_name = getattr(component, "__qualname__", repr(component))
        # Module names vary between direct CLI execution (``__main__``), runpy,
        # and test loaders. The qualified name and source text identify these
        # repository-local functions without making the fingerprint depend on
        # the loading mechanism.
        components[f"source:{qualified_name}"] = inspect.getsource(component)
        if not inspect.isfunction(component):
            continue
        module = getattr(component, "__module__", None)
        for name in sorted(component.__code__.co_names):
            dependency = component.__globals__.get(name)
            if inspect.isfunction(dependency) and getattr(
                dependency, "__module__", None
            ) == module:
                pending.append(dependency)
            elif name.isupper() and dependency is not None:
                components[f"global:{name}"] = fingerprint_value(dependency)
    return sha256_bytes(json_bytes(components))


def slugify(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", value)
    ascii_value = normalized.encode("ascii", "ignore").decode("ascii").lower()
    slug = re.sub(r"[^a-z0-9]+", "-", ascii_value).strip("-")
    return slug or "book"


def plain_heading(markup: str) -> str:
    value = markup.strip()
    value = re.sub(
        r"</?(?:b|br|code|em|i|span|strong)\b[^>]*>",
        "",
        value,
        flags=re.IGNORECASE,
    )
    previous = None
    while value != previous:
        previous = value
        value = re.sub(r"^(?:\*\*|__|\*|_)(.*?)(?:\*\*|__|\*|_)$", r"\1", value)
        value = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", value)
    return html.unescape(value).strip()


def heading(line: str) -> tuple[int, str] | None:
    match = HEADING_RE.match(line)
    if not match:
        return None
    return len(match.group(1)), plain_heading(match.group(2))


def opened_fence(line: str) -> tuple[str, int] | None:
    match = FENCE_OPEN_RE.match(line)
    if not match:
        return None
    delimiter = match.group(1)
    if delimiter[0] == "`" and "`" in match.group(2):
        return None
    return delimiter[0], len(delimiter)


def closed_fence(line: str, active_fence: tuple[str, int]) -> bool:
    character, minimum_length = active_fence
    return bool(
        re.fullmatch(
            rf" {{0,3}}{re.escape(character)}{{{minimum_length},}}[ \t]*", line
        )
    )


def next_fence_state(
    line: str, active_fence: tuple[str, int] | None
) -> tuple[tuple[str, int] | None, bool]:
    if active_fence is not None:
        if closed_fence(line, active_fence):
            return None, True
        return active_fence, False
    opening = opened_fence(line)
    return opening, opening is not None


def discover_sources(root: Path) -> list[Path]:
    source_directory = root / SOURCE_DIRECTORY
    if source_directory.is_symlink():
        raise BookConversionError("sources/ must not be a symbolic link")
    if not source_directory.is_dir():
        raise BookConversionError("sources/ is missing or is not a directory")
    sources = sorted(
        (
            child
            for child in source_directory.iterdir()
            if child.is_file()
            and not child.is_symlink()
            and child.suffix.lower() in SUPPORTED_SUFFIXES
        ),
        key=lambda child: (child.name.casefold(), child.name),
    )
    if not sources:
        raise BookConversionError("sources/ contains no direct PDF or EPUB files")
    slugs: dict[str, Path] = {}
    for source in sources:
        slug = slugify(source.stem)
        if slug in slugs:
            raise BookConversionError(
                f"source filenames collide on slug '{slug}': {slugs[slug].name!r} and "
                f"{source.name!r}"
            )
        slugs[slug] = source
    return sources


def source_repository_path(root: Path, source: Path) -> str:
    try:
        return source.relative_to(root).as_posix()
    except ValueError as error:
        raise BookConversionError(
            f"source is outside the repository root: {source}"
        ) from error


def command_result(argv: list[str], cwd: Path) -> dict[str, object]:
    try:
        completed = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)
    except OSError as error:
        return {
            "argv": argv,
            "command": shlex.join(argv),
            "working_directory": str(cwd),
            "exit_status": 127,
            "stdout": "",
            "stderr": f"unable to execute converter: {error}",
        }
    return {
        "argv": argv,
        "command": shlex.join(argv),
        "working_directory": str(cwd),
        "exit_status": completed.returncode,
        "stdout": completed.stdout,
        "stderr": completed.stderr,
    }


def significant_messages(output: str) -> tuple[list[str], list[str]]:
    warnings: list[str] = []
    failures: list[str] = []
    for raw_line in output.replace("\r", "\n").splitlines():
        line = raw_line.strip()
        if not line:
            continue
        if "OCR Error Detection:" in line:
            continue
        if re.search(r"error:.*model.*(?:not found|not loaded)", line, re.I):
            warnings.append(line)
        elif re.search(r"\b(?:error|failed|failure|exception|traceback)\b", line, re.I):
            failures.append(line)
        elif re.search(r"\b(?:warn(?:ing)?|deprecated|fallback)\b", line, re.I):
            warnings.append(line)
    return list(dict.fromkeys(warnings)), list(dict.fromkeys(failures))


def markdown_safe_diagnostic(value: object) -> str:
    """Remove terminal controls only at the human-facing Markdown boundary."""
    text = TERMINAL_ESCAPE_RE.sub("", str(value))
    text = NON_MARKDOWN_CONTROL_RE.sub("", text).strip()
    return text or "(terminal control output omitted)"


def selected_converter_attempt(converter: dict[str, object]) -> dict[str, object]:
    """Return the exact successful attempt selected for publication."""
    attempts = converter.get("attempts")
    target = converter.get("execution_target")
    selected_number = converter.get("selected_attempt_number")
    if not isinstance(attempts, list) or not isinstance(target, str):
        raise BookConversionError("converter attempt provenance is incomplete")
    matching = [
        attempt
        for attempt in attempts
        if isinstance(attempt, dict)
        and attempt.get("execution_target") == target
        and attempt.get("exit_status") == 0
        and attempt.get("fresh_output_validated") is True
    ]
    if isinstance(selected_number, int):
        matching = [
            attempt
            for attempt in matching
            if attempt.get("attempt_number") == selected_number
        ]
    if not matching:
        raise BookConversionError(
            f"no successful validated converter attempt exists for {target}"
        )
    return matching[-1]


def canonicalize_converter_selection(converter: dict[str, object]) -> None:
    """Bind summary provenance to the successful attempt, including retries."""
    selected = selected_converter_attempt(converter)
    attempt_number = selected.get("attempt_number")
    if not isinstance(attempt_number, int):
        attempt_number = 1
        selected["attempt_number"] = attempt_number
    converter["selected_attempt_number"] = attempt_number
    converter["converter_exit_status"] = selected["exit_status"]
    converter["command_executed"] = selected["command"]
    converter["command_argv"] = selected["argv"]
    converter["working_directory"] = selected["working_directory"]


def tool_version(command: list[str], cwd: Path) -> str | None:
    try:
        result = subprocess.run(
            command, cwd=cwd, capture_output=True, text=True, timeout=30
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    return next(
        (line.strip() for line in result.stdout.splitlines() if line.strip()), None
    )


def marker_version(root: Path, execution_target: str) -> str | None:
    configured = os.environ.get("BOOKS_MARKER_VERSION")
    if configured:
        return configured
    if execution_target != "local":
        return None
    python = Path.home() / "git" / "marker" / ".venv" / "bin" / "python"
    if not python.is_file():
        return None
    version = tool_version(
        [
            str(python),
            "-c",
            "import importlib.metadata as m; print(m.version('marker-pdf'))",
        ],
        root,
    )
    return f"marker-pdf {version}" if version else None


def pipeline_fingerprint() -> str:
    configured = os.environ.get("BOOKS_PIPELINE_FINGERPRINT")
    if configured:
        return configured
    return sha256_file(Path(__file__).resolve())


def raw_conversion_stage_fingerprint(current_pipeline_fingerprint: str) -> str:
    """Identify source-to-raw conversion independently of corpus post-processing."""
    configured = os.environ.get("BOOKS_RAW_CONVERSION_FINGERPRINT")
    if configured:
        return configured
    if os.environ.get("BOOKS_PIPELINE_FINGERPRINT"):
        return current_pipeline_fingerprint
    return raw_stage_implementation_fingerprint(convert_pdf, convert_epub)


def pandoc_version(root: Path, executable: str) -> str | None:
    configured = os.environ.get("BOOKS_PANDOC_VERSION")
    return configured or tool_version([executable, "--version"], root)


def pdf_information(source: Path) -> dict[str, object]:
    try:
        completed = subprocess.run(
            ["pdfinfo", str(source)], capture_output=True, text=True, timeout=60
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}
    if completed.returncode != 0:
        return {}
    information: dict[str, object] = {}
    for line in completed.stdout.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        information[key.strip()] = value.strip()
    if str(information.get("Pages", "")).isdigit():
        information["Pages"] = int(str(information["Pages"]))
    return information


def epub_information(source: Path) -> dict[str, object]:
    result: dict[str, object] = {
        "titles": [],
        "creators": [],
        "contributors": [],
        "languages": [],
        "identifiers": [],
        "publishers": [],
        "dates": [],
        "subjects": [],
        "rights": [],
        "descriptions": [],
        "spine": [],
        "navigation": [],
    }
    try:
        with zipfile.ZipFile(source) as archive:
            container = ET.fromstring(archive.read("META-INF/container.xml"))
            rootfile = next(
                element
                for element in container.iter()
                if element.tag.rsplit("}", 1)[-1] == "rootfile"
            )
            package_path = rootfile.attrib["full-path"]
            package = ET.fromstring(archive.read(package_path))
            mapping = {
                "title": "titles",
                "creator": "creators",
                "contributor": "contributors",
                "language": "languages",
                "identifier": "identifiers",
                "publisher": "publishers",
                "date": "dates",
                "subject": "subjects",
                "rights": "rights",
                "description": "descriptions",
            }
            for element in package.iter():
                local_name = element.tag.rsplit("}", 1)[-1]
                if local_name in mapping and element.text and element.text.strip():
                    entry: dict[str, object] = {"value": element.text.strip()}
                    if element.attrib:
                        entry["attributes"] = dict(sorted(element.attrib.items()))
                    result[mapping[local_name]].append(entry)  # type: ignore[union-attr]
            manifest = {
                element.attrib.get("id"): dict(sorted(element.attrib.items()))
                for element in package.iter()
                if element.tag.rsplit("}", 1)[-1] == "item"
            }
            package_directory = PurePosixPath(package_path).parent
            navigation_items = [
                item
                for item in manifest.values()
                if "nav" in str(item.get("properties", "")).split()
            ]
            if navigation_items:
                navigation_path = str(package_directory / navigation_items[0]["href"])
                navigation_document = ET.fromstring(archive.read(navigation_path))

                def direct_children(
                    element: ET.Element, local_name: str
                ) -> list[ET.Element]:
                    return [
                        child
                        for child in list(element)
                        if child.tag.rsplit("}", 1)[-1] == local_name
                    ]

                def navigation_list(ordered_list: ET.Element, depth: int) -> None:
                    for item in direct_children(ordered_list, "li"):
                        anchors = [
                            element
                            for element in item.iter()
                            if element.tag.rsplit("}", 1)[-1] == "a"
                        ]
                        if anchors:
                            anchor = anchors[0]
                            title = " ".join("".join(anchor.itertext()).split())
                            if title:
                                result["navigation"].append(  # type: ignore[union-attr]
                                    {
                                        "title": title,
                                        "href": anchor.attrib.get("href"),
                                        "depth": depth,
                                        "source": "epub-nav",
                                    }
                                )
                        for nested in direct_children(item, "ol"):
                            navigation_list(nested, depth + 1)

                for navigation in (
                    element
                    for element in navigation_document.iter()
                    if element.tag.rsplit("}", 1)[-1] == "nav"
                ):
                    navigation_type = next(
                        (
                            value
                            for key, value in navigation.attrib.items()
                            if key.rsplit("}", 1)[-1] == "type"
                        ),
                        "",
                    )
                    if navigation_type and navigation_type != "toc":
                        continue
                    for ordered_list in direct_children(navigation, "ol"):
                        navigation_list(ordered_list, 1)
                    if result["navigation"]:
                        break
            if not result["navigation"]:
                ncx_items = [
                    item
                    for item in manifest.values()
                    if item.get("media-type") == "application/x-dtbncx+xml"
                ]
                if ncx_items:
                    ncx_path = str(package_directory / ncx_items[0]["href"])
                    ncx_document = ET.fromstring(archive.read(ncx_path))
                    nav_map = next(
                        (
                            element
                            for element in ncx_document.iter()
                            if element.tag.rsplit("}", 1)[-1] == "navMap"
                        ),
                        None,
                    )

                    def ncx_points(parent: ET.Element, depth: int) -> None:
                        points = [
                            child
                            for child in list(parent)
                            if child.tag.rsplit("}", 1)[-1] == "navPoint"
                        ]
                        for point in points:
                            label = next(
                                (
                                    element
                                    for element in point.iter()
                                    if element.tag.rsplit("}", 1)[-1] == "text"
                                    and element.text
                                    and element.text.strip()
                                ),
                                None,
                            )
                            content = next(
                                (
                                    element
                                    for element in point.iter()
                                    if element.tag.rsplit("}", 1)[-1] == "content"
                                ),
                                None,
                            )
                            if label is not None and content is not None:
                                result["navigation"].append(  # type: ignore[union-attr]
                                    {
                                        "title": " ".join(label.text.split()),
                                        "href": content.attrib.get("src"),
                                        "depth": depth,
                                        "source": "epub-ncx",
                                    }
                                )
                            ncx_points(point, depth + 1)

                    if nav_map is not None:
                        ncx_points(nav_map, 1)
            for element in package.iter():
                if element.tag.rsplit("}", 1)[-1] != "itemref":
                    continue
                idref = element.attrib.get("idref")
                result["spine"].append(  # type: ignore[union-attr]
                    {
                        "idref": idref,
                        "linear": element.attrib.get("linear", "yes"),
                        "manifest_item": manifest.get(idref),
                    }
                )
            top_level_navigation = [
                entry
                for entry in result["navigation"]  # type: ignore[union-attr]
                if entry.get("depth") == 1
            ]
            spine_entries = result["spine"]
            if len(top_level_navigation) == len(spine_entries):  # type: ignore[arg-type]
                for navigation_entry, spine_entry in zip(
                    top_level_navigation,
                    spine_entries,
                    strict=True,  # type: ignore[arg-type]
                ):
                    manifest_item = spine_entry.get("manifest_item") or {}
                    navigation_entry["spine_href"] = manifest_item.get("href")
            result["package_path"] = package_path
    except (KeyError, StopIteration, ET.ParseError, zipfile.BadZipFile):
        result["parse_error"] = "EPUB package metadata could not be parsed"
    return result


def raw_output_is_fresh(
    markdown_path: Path, metadata_path: Path | None, expected_pages: int | None
) -> tuple[bool, str | None, dict[str, object] | None]:
    if not markdown_path.is_file() or markdown_path.stat().st_size == 0:
        return False, "converter did not produce non-empty Markdown", None
    if metadata_path is None:
        return True, None, None
    if not metadata_path.is_file():
        return False, "Marker did not produce its metadata JSON", None
    try:
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, UnicodeDecodeError):
        return False, "Marker metadata JSON is malformed", None
    page_stats = metadata.get("page_stats")
    if not isinstance(page_stats, list) or not page_stats:
        return False, "Marker metadata contains no page statistics", metadata
    if expected_pages is not None and len(page_stats) != expected_pages:
        return (
            False,
            f"Marker returned {len(page_stats)} pages; source reports {expected_pages}",
            metadata,
        )
    return True, None, metadata


def overridden_command(
    environment_name: str, default_script: Path
) -> tuple[list[str], bool]:
    override = os.environ.get(environment_name)
    if override:
        return [override], True
    return ["bash", str(default_script)], False


def pdf_xray_command() -> tuple[list[str], bool]:
    return [sys.executable, str(DEFAULT_PDF_CDR), "--scan-only"], bool(
        os.environ.get("BOOKS_PDF_XRAY")
    )


def pdf_cdr_command() -> tuple[list[str], bool]:
    override = os.environ.get("BOOKS_PDF_CDR")
    if override:
        return [override], True
    return [sys.executable, str(DEFAULT_PDF_CDR)], False


def command_file_identity(argument: str) -> dict[str, str | None]:
    configured_path = Path(argument).expanduser()
    resolved_path: Path | None = None
    if configured_path.is_file():
        resolved_path = configured_path.resolve()
    elif os.sep not in argument and (located := shutil.which(argument)):
        resolved_path = Path(located).resolve()
    return {
        "argument": argument,
        "resolved_path": str(resolved_path) if resolved_path else None,
        "sha256": sha256_file(resolved_path) if resolved_path else None,
    }


def command_prefix_identity(arguments: list[str]) -> list[dict[str, str | None]]:
    return [command_file_identity(argument) for argument in arguments]


def conversion_environment_identity() -> dict[str, object]:
    variables = {
        name: {"sha256": sha256_bytes(value.encode("utf-8"))}
        for name, value in sorted(os.environ.items())
        if name.startswith("BOOKS_") or name in {"HOME", "PATH"}
    }
    return {
        "os_name": os.name,
        "platform": sys.platform,
        "python_version": platform.python_version(),
        "python_executable": command_file_identity(sys.executable),
        "variables": variables,
    }


def pdf_raw_conversion_identity(
    root: Path, common_identity: dict[str, object]
) -> dict[str, object]:
    peecee_prefix, peecee_overridden = overridden_command(
        "BOOKS_MARKER_PEECEE", DEFAULT_MARKER_PEECEE
    )
    local_prefix, local_overridden = overridden_command(
        "BOOKS_MARKER_LOCAL", DEFAULT_MARKER_LOCAL
    )
    xray_prefix, xray_overridden = pdf_xray_command()
    cdr_prefix, cdr_overridden = pdf_cdr_command()
    return {
        **common_identity,
        "converter": "marker",
        "helpers": {
            "peecee": command_prefix_identity(peecee_prefix),
            "local": command_prefix_identity(local_prefix),
            "pdf_xray": command_prefix_identity(xray_prefix),
            "pdf_xray_backend": command_prefix_identity(
                [os.environ.get("BOOKS_PDF_XRAY", str(DEFAULT_PDF_XRAY))]
            ),
            "pdf_cdr": command_prefix_identity(cdr_prefix),
        },
        "helper_overrides": {
            "peecee": peecee_overridden,
            "local": local_overridden,
            "pdf_xray": xray_overridden,
            "pdf_cdr": cdr_overridden,
        },
        "converter_versions": {
            "peecee": marker_version(root, "peecee"),
            "local": marker_version(root, "local"),
        },
        "options": {
            "format": "markdown",
            "primary_target": "peecee",
            "fallback_target": "local",
            "fallback_policy": "infrastructure-failure-only",
            "remote_clean": not bool(os.environ.get("BOOKS_SKIP_REMOTE_CLEAN")),
            "pdf_safety": {
                "airlock": "required-before-marker",
                "dangerous_input": "sandboxed-raster-cdr",
                "suspect_input": "sandboxed-raster-cdr",
                "required_derivative_verdict": "CLEAN-or-CDR-CLEAN",
                "source_xray_policy": PDF_SOURCE_XRAY_POLICY,
                "derivative_xray_policy": PDF_DERIVATIVE_XRAY_POLICY,
            },
        },
        "supporting_commands": {
            "pdfinfo": command_file_identity("pdfinfo"),
            "ssh": command_file_identity("ssh"),
            "bwrap": command_file_identity(
                os.environ.get("BOOKS_PDF_BWRAP", "bwrap")
            ),
            "ghostscript": command_file_identity(
                os.environ.get("BOOKS_PDF_GS", "gs")
            ),
            "mutool": command_file_identity(
                os.environ.get("BOOKS_PDF_MUTOOL", "mutool")
            ),
        },
    }


def epub_raw_conversion_identity(
    root: Path, common_identity: dict[str, object]
) -> dict[str, object]:
    executable = os.environ.get("BOOKS_PANDOC", "pandoc")
    return {
        **common_identity,
        "converter": "pandoc",
        "helpers": {"pandoc": command_file_identity(executable)},
        "converter_versions": {"local": pandoc_version(root, executable)},
        "options": {
            "from": "epub",
            "to": "gfm",
            "wrap": "none",
            "markdown_headings": "atx",
            "extract_media": "assets",
        },
    }


def raw_conversion_identity(
    source: Path, root: Path, conversion_stage_fingerprint: str
) -> dict[str, object]:
    common_identity: dict[str, object] = {
        "schema_version": "books-raw-conversion/1",
        "source_format": source.suffix.lower().lstrip("."),
        "conversion_stage_fingerprint": conversion_stage_fingerprint,
        "environment": conversion_environment_identity(),
    }
    if source.suffix.lower() == ".pdf":
        return pdf_raw_conversion_identity(root, common_identity)
    return epub_raw_conversion_identity(root, common_identity)


def raw_conversion_fingerprint(identity: dict[str, object]) -> str:
    return sha256_bytes(json_bytes(identity))


def has_legacy_raw_provenance(record: dict[str, object]) -> bool:
    return (
        "raw_conversion_identity" not in record
        and "raw_conversion_fingerprint" not in record
    )


def raw_conversion_cacheable(
    identity: dict[str, object], execution_target: object
) -> bool:
    versions = identity.get("converter_versions")
    if not isinstance(versions, dict) or not isinstance(execution_target, str):
        return False
    version = versions.get(execution_target)
    return isinstance(version, str) and bool(version.strip())


