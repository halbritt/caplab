{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://books.local/doctrine/evaluations/robustness/skill-eval-result.schema.json",
  "title": "Doctrine skill paired evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "case_hash", "control", "treatment", "control_receipt_hash", "treatment_receipt_hash", "pair_status", "human_status", "human_review", "result_hash"],
  "properties": {
    "schema_version": {"const": "doctrine-skill-eval-result/1"},
    "case_id": {"type": "string", "minLength": 1},
    "case_hash": {"$ref": "#/$defs/hash"},
    "control": {"$ref": "#/$defs/arm"},
    "treatment": {"$ref": "#/$defs/arm"},
    "control_receipt_hash": {"$ref": "#/$defs/hash"},
    "treatment_receipt_hash": {"$ref": "#/$defs/hash"},
    "pair_status": {"enum": ["improved", "stable-pass", "regressed", "both-failed"]},
    "human_status": {"const": "pending"},
    "human_review": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["criterion", "status"], "properties": {"criterion": {"type": "string", "minLength": 1}, "status": {"const": "pending"}}}},
    "result_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "arm": {"type": "object", "additionalProperties": false, "required": ["status", "criteria", "hard_failures"], "properties": {"status": {"enum": ["passed", "failed"]}, "criteria": {"type": "array", "items": {"type": "object"}}, "hard_failures": {"type": "array", "items": {"type": "string"}}}}
  }
}
