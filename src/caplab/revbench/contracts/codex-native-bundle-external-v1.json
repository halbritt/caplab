      },
      "verdict": {
        "enum": [
          "clean",
          "defect"
        ]
      },
      "anchors": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "uniqueItems": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "verdict": {
              "const": "clean"
            }
          }
        },
        "then": {
          "properties": {
            "anchors": {
              "maxItems": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "verdict": {
              "const": "defect"
            }
          }
        },
        "then": {
          "properties": {
            "anchors": {
              "minItems": 1
            }
          }
        }
      }
    ]
  },
