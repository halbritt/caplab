{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethogram.local/doctrine/evaluations/replay-fixture.schema.json",
  "title": "Synthetic OpenAI evaluation replay fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "mode",
    "consumer",
    "provenance",
    "request",
    "request_sha256",
    "response",
    "response_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evaluation-replay-fixture/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "mode": {"const": "replay"},
    "consumer": {"enum": ["doctrine-injection", "entailment"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "captured_from_live"],
      "properties": {
        "kind": {"const": "synthetic"},
        "captured_from_live": {"const": false}
      }
    },
    "request": {
      "type": "object",
      "required": ["model", "messages", "max_tokens"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {"enum": ["system", "user", "assistant"]},
              "content": {"type": "string"}
            }
          }
        },
        "max_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "choices"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finish_reason", "message"],
            "properties": {
              "finish_reason": {"type": "string"},
              "message": {
                "type": "object",
                "additionalProperties": false,
                "required": ["content"],
                "properties": {
                  "content": {"type": "string"},
                  "reasoning_content": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
