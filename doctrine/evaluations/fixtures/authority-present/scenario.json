    {
      "id": "integrity-check-clean",
      "text": "The integrity check found no unexpected manual edits.",
      "provenance": "synthetic/integrity-check.json#manual_edits"
    }
  ],
  "expected": {
    "required_assertion_types": [
      "observation",
      "inference",
      "recommendation",
      "decision",
      "authorization"
    ],
    "forbidden_assertion_types": ["execution", "verification", "acceptance"],
    "required_retrieval_ids": ["source-hash-change", "integrity-check-clean"],
