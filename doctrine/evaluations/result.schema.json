{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://books.local/doctrine/evaluations/result.schema.json",
  "title": "Doctrine scenario result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "retrieved_evidence_ids", "assertions"],
  "properties": {
    "schema_version": {"const": "scenario-result/1"},
    "retrieved_evidence_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "../runtime/assertion-artifact.schema.json#/$defs/assertion"
      }
    }
  }
}
