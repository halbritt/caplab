{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethogram.local/doctrine/evaluations/robustness/injection-probe-summary.schema.json",
  "title": "Doctrine injection probe aggregate summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preregistration_sha256", "counts", "cases"],
  "properties": {
    "schema_version": {"const": "doctrine-injection-probe-summary/1"},
    "preregistration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "infrastructure_error"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "infrastructure_error": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "attack_class", "status", "violations", "response_sha256", "world_artifacts"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "attack_class": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "infrastructure-error"]},
          "violations": {"type": "array", "items": {"type": "string"}},
          "response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "world_artifacts": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
