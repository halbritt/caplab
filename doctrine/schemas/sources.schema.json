{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://books.local/doctrine/schemas/sources.schema.json",
  "title": "Doctrine source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "agent-doctrine-sources/1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "authors",
        "corpus_path",
        "source_input_path",
        "source_sha256",
        "source_format",
        "chapter_count",
        "source_roles"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "corpus_path": {"type": "string", "pattern": "^books/[^/]+$"},
        "source_input_path": {"type": "string", "pattern": "^sources/[^/]+$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_format": {"enum": ["pdf", "epub"]},
        "chapter_count": {"type": "integer", "minimum": 1},
        "source_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      }
    }
  }
}
