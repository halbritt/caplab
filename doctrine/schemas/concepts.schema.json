{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/agent-doctrine/concepts.schema.json",
  "title": "Agent doctrine concept collection",
  "type": "object",
  "required": ["schema_version", "concepts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "agent-doctrine-concepts/1"},
    "concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/concept"}
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "sourceSupport": {
      "type": "object",
      "required": ["source_id", "locator", "contribution", "relationship"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+$"},
        "locator": {"type": "string", "minLength": 1},
        "contribution": {"type": "string", "minLength": 1},
        "relationship": {
          "enum": [
            "direct_support",
            "corroboration",
            "refinement",
            "derived_inference",
            "terminology_variant",
            "historical_precursor",
            "tension"
          ]
        }
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "activate_for_roles",
        "activate_for_tasks",
        "activate_for_repository_signals",
        "activate_for_languages",
        "activate_for_risk_classes",
        "exclude_when",
        "prerequisites",
        "retrieval_priority",
        "retrieval_budget_hint",
        "related_concepts"
      ],
      "additionalProperties": false,
      "properties": {
        "activate_for_roles": {"$ref": "#/$defs/nonEmptyStrings"},
        "activate_for_tasks": {"$ref": "#/$defs/nonEmptyStrings"},
        "activate_for_repository_signals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "activate_for_languages": {"$ref": "#/$defs/nonEmptyStrings"},
        "activate_for_risk_classes": {"$ref": "#/$defs/nonEmptyStrings"},
        "exclude_when": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "prerequisites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "retrieval_priority": {"enum": ["core", "high", "normal", "specialist"]},
        "retrieval_budget_hint": {"type": "integer", "minimum": 80, "maximum": 4000},
        "related_concepts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "uniqueItems": true}
      }
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "claim",
        "decision_rule",
        "why_it_matters",
        "applicable_when",
        "required_evidence",
        "insufficient_evidence",
        "required_inputs",
        "expected_outputs",
        "preservation_boundaries",
        "safe_actions",
        "unsafe_actions",
        "common_failure_modes",
        "source_support",
        "confidence",
        "roles",
        "languages",
        "repository_archetypes",
        "retrieval_terms",
        "routing"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "category": {"enum": ["universal", "implementation", "architecture", "refactoring", "legacy", "domain", "performance", "review", "agent-conduct"]},
        "claim": {"type": "string", "minLength": 1},
        "decision_rule": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string", "minLength": 1},
        "applicable_when": {"$ref": "#/$defs/nonEmptyStrings"},
        "not_applicable_when": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "insufficient_evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "required_inputs": {"$ref": "#/$defs/nonEmptyStrings"},
        "expected_outputs": {"$ref": "#/$defs/nonEmptyStrings"},
        "preservation_boundaries": {"$ref": "#/$defs/nonEmptyStrings"},
        "safe_actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "unsafe_actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "common_failure_modes": {"$ref": "#/$defs/nonEmptyStrings"},
        "counterexamples": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "interactions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conflicts": {"type": "array", "items": {"type": "string", "pattern": "^conflict-[a-z0-9-]+$"}, "uniqueItems": true},
        "source_support": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceSupport"}},
        "confidence": {"enum": ["universal", "strong", "contextual", "weak", "contested"]},
        "roles": {"$ref": "#/$defs/nonEmptyStrings"},
        "languages": {"$ref": "#/$defs/nonEmptyStrings"},
        "repository_archetypes": {"$ref": "#/$defs/nonEmptyStrings"},
        "retrieval_terms": {"$ref": "#/$defs/nonEmptyStrings"},
        "routing": {"$ref": "#/$defs/routing"}
      }
    }
  }
}
