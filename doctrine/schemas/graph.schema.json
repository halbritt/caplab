{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/agent-doctrine/graph.schema.json",
  "title": "Canonical doctrine graph records",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]+$"},
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "mapping": {
      "type": "object",
      "required": ["node_id", "relationship_to_canonical"],
      "additionalProperties": false,
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "relationship_to_canonical": {
          "enum": [
            "direct_support",
            "corroboration",
            "refinement",
            "derived_inference",
            "terminology_variant",
            "historical_precursor",
            "tension"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label",
        "definition",
        "operational_significance",
        "status",
        "confidence",
        "doctrine_refs",
        "formulations",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "principle",
            "heuristic",
            "transformation",
            "pattern",
            "anti-pattern",
            "proof-obligation",
            "tradeoff",
            "smell",
            "constraint",
            "terminology",
            "procedure",
            "evidence-class"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "operational_significance": {"type": "string", "minLength": 1},
        "status": {"enum": ["canonical", "contextual", "contested", "historical"]},
        "confidence": {"enum": ["universal", "strong", "contextual", "weak", "contested"]},
        "doctrine_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "formulations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "tags": {"$ref": "#/$defs/strings"}
      }
    },
    "formulation": {
      "type": "object",
      "required": [
        "id",
        "source_id",
        "locator",
        "mappings",
        "paraphrase",
        "conditions",
        "caveats"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+$"},
        "locator": {"type": "string", "pattern": "^books/.+\\.md#.+$"},
        "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}},
        "paraphrase": {"type": "string", "minLength": 1},
        "conditions": {"type": "string", "minLength": 1},
        "caveats": {"type": "string", "minLength": 1}
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "relation",
        "to",
        "claim",
        "conditions",
        "derivation",
        "confidence",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "relation": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "claim": {"type": "string", "minLength": 1},
        "conditions": {"$ref": "#/$defs/strings"},
        "derivation": {"enum": ["direct", "corroborated", "synthesized", "contested"]},
        "confidence": {"enum": ["universal", "strong", "contextual", "weak", "contested"]},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "conflict_ref": {"type": "string", "pattern": "^conflict-[a-z0-9-]+$"}
      }
    }
  }
}
