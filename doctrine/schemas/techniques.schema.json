{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/agent-doctrine/techniques.schema.json",
  "title": "Contextual architecture and domain technique catalog",
  "type": "object",
  "required": ["schema_version", "catalog", "scope", "non_universality", "techniques"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "agent-doctrine-techniques/1"},
    "catalog": {"enum": ["architecture", "domain"]},
    "scope": {"const": "specialist"},
    "non_universality": {"type": "string", "minLength": 1},
    "techniques": {
      "type": "array",
      "items": {"$ref": "#/$defs/technique"}
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "sourceSupport": {
      "type": "object",
      "required": ["source_id", "locator", "contribution", "relationship"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+$"},
        "locator": {"type": "string", "minLength": 1},
        "contribution": {"type": "string", "minLength": 1},
        "relationship": {
          "enum": ["direct_support", "corroboration", "refinement", "derived_inference", "terminology_variant", "historical_precursor", "tension"]
        }
      }
    },
    "reversalCost": {
      "type": "object",
      "required": ["level", "exit_path", "cost_drivers"],
      "additionalProperties": false,
      "properties": {
        "level": {"type": "string", "minLength": 1},
        "exit_path": {"type": "string", "minLength": 1},
        "cost_drivers": {"$ref": "#/$defs/strings"}
      }
    },
    "technique": {
      "type": "object",
      "required": [
        "id",
        "candidate_id",
        "title",
        "non_universality",
        "problem_solved",
        "activation_evidence",
        "costs",
        "contraindications",
        "reversal_cost",
        "appropriate_scale",
        "operational_consequences",
        "preservation_boundaries",
        "alternatives",
        "related_concepts",
        "source_support"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(architecture|domain)-[a-z0-9-]+$"},
        "candidate_id": {"type": "string", "pattern": "^TECH-(ARC|DOM)-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "non_universality": {"type": "string", "minLength": 1},
        "problem_solved": {"type": "string", "minLength": 1},
        "activation_evidence": {"$ref": "#/$defs/strings"},
        "costs": {"$ref": "#/$defs/strings"},
        "contraindications": {"$ref": "#/$defs/strings"},
        "reversal_cost": {"$ref": "#/$defs/reversalCost"},
        "appropriate_scale": {"$ref": "#/$defs/strings"},
        "operational_consequences": {"$ref": "#/$defs/strings"},
        "preservation_boundaries": {"$ref": "#/$defs/strings"},
        "alternatives": {"$ref": "#/$defs/strings"},
        "related_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "uniqueItems": true
        },
        "source_support": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceSupport"}
        }
      }
    }
  }
}
