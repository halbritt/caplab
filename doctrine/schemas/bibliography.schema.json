{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://books.local/doctrine/schemas/bibliography.schema.json",
  "title": "Canonical corpus bibliography",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata_policy",
    "provenance_policy",
    "books"
  ],
  "properties": {
    "schema_version": {"const": "books-bibliography/1"},
    "metadata_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_catalog", "generated_book_metadata"],
      "properties": {
        "canonical_catalog": {"const": "this-manifest"},
        "generated_book_metadata": {
          "const": "legacy-extracted-noncanonical"
        }
      }
    },
    "provenance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "derived-inference"],
      "properties": {
        "direct": {"type": "string", "minLength": 1},
        "derived-inference": {"type": "string", "minLength": 1}
      }
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/book"}
    }
  },
  "$defs": {
    "evidencePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:books/.+\\.md|sources/[^/]+)$"
      }
    },
    "support": {"enum": ["direct", "derived-inference"]},
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_path",
        "slug",
        "title",
        "title_evidence",
        "edition",
        "creators",
        "generated_metadata_status"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
        "source_path": {"type": "string", "pattern": "^sources/[^/]+$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "title_evidence": {"$ref": "#/$defs/evidencePaths"},
        "edition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "number", "support", "evidence"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "number": {"type": "integer", "minimum": 1},
            "support": {"$ref": "#/$defs/support"},
            "evidence": {"$ref": "#/$defs/evidencePaths"}
          }
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "support", "evidence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "role": {
                "enum": [
                  "author",
                  "contributor",
                  "editor",
                  "translator",
                  "foreword-author"
                ]
              },
              "support": {"$ref": "#/$defs/support"},
              "evidence": {"$ref": "#/$defs/evidencePaths"}
            }
          }
        },
        "generated_metadata_status": {
          "const": "legacy-extracted-noncanonical"
        }
      }
    }
  }
}
