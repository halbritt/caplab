{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://books.local/doctrine/runtime/dependency-manifest.schema.json",
  "title": "Corpus dependency manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "dependency-manifest/1"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "content_hash"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "source",
              "chapter",
              "formulation",
              "concept",
              "graph-view",
              "index",
              "prompt",
              "skill",
              "evaluation",
              "receipt"
            ]
          },
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]+$"},
          "producer": {"type": ["string", "null"]},
          "producer_version": {"type": ["string", "null"]},
          "schema_version": {"type": ["string", "null"]},
          "assertion_type": {
            "type": ["string", "null"],
            "enum": [
              "observation",
              "inference",
              "recommendation",
              "decision",
              "authorization",
              "execution",
              "verification",
              "acceptance",
              null
            ]
          },
          "verification_receipt": {"type": ["string", "null"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer", "provider", "relation"],
        "properties": {
          "consumer": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "relation": {
            "enum": [
              "derives_from",
              "indexes",
              "packages",
              "compiles",
              "evaluates",
              "verifies"
            ]
          }
        }
      }
    }
  }
}
