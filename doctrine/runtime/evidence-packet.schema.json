{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://books.local/doctrine/runtime/evidence-packet.schema.json",
  "title": "Doctrine evidence packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "packet_content_sha256",
    "question",
    "corpus_version",
    "doctrine_version",
    "retriever_version",
    "retrieval_context",
    "retrieval_budget",
    "budget_excluded",
    "activated_concepts",
    "activated_procedures",
    "activated_lenses",
    "activated_prohibitions",
    "required_evidence_classes",
    "authority_constraints",
    "applicable_change_types",
    "doctrine_artifacts",
    "evidence_records",
    "evidence_obligations",
    "activation_reasons",
    "provenance_links",
    "conflicts",
    "excluded_candidates"
  ],
  "properties": {
    "schema_version": {"const": "evidence-packet/2"},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "doctrine_version": {"type": "string", "pattern": "^doctrine-[0-9a-f]{16}$"},
    "retriever_version": {"type": "string", "pattern": "^retriever-[0-9a-f]{16}$"},
    "retrieval_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_role",
        "canonical_role",
        "requested_task",
        "task_family",
        "task_variants",
        "requested_lenses",
        "signals",
        "languages",
        "risk_class",
        "detail",
        "evidence_ids",
        "retrieval_budget"
      ],
      "properties": {
        "requested_role": {"type": "string", "minLength": 1},
        "canonical_role": {"type": "string", "minLength": 1},
        "requested_task": {"type": "string", "minLength": 1},
        "task_family": {"type": "string", "minLength": 1},
        "task_variants": {"$ref": "#/$defs/strings"},
        "requested_lenses": {"$ref": "#/$defs/identifiers"},
        "signals": {"$ref": "#/$defs/strings"},
        "languages": {"$ref": "#/$defs/strings"},
        "risk_class": {"type": ["string", "null"]},
        "detail": {"enum": ["compact", "full"]},
        "evidence_ids": {"$ref": "#/$defs/identifiers"},
        "retrieval_budget": {"type": "integer", "minimum": 1}
      }
    },
    "retrieval_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "scope",
        "meaning",
        "requested",
        "minimum_required",
        "used",
        "remaining"
      ],
      "properties": {
        "unit": {"const": "relative-routing-cost-unit"},
        "scope": {"const": "activated-concept-selection-only"},
        "meaning": {"type": "string", "minLength": 1},
        "requested": {"type": "integer", "minimum": 1},
        "minimum_required": {"type": "integer", "minimum": 0},
        "used": {"type": "integer", "minimum": 0},
        "remaining": {"type": "integer", "minimum": 0}
      }
    },
    "budget_excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cost", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "cost": {"type": "integer", "minimum": 0},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "activated_concepts": {"$ref": "#/$defs/identifiers"},
    "activated_procedures": {"$ref": "#/$defs/identifiers"},
    "activated_lenses": {"$ref": "#/$defs/identifiers"},
    "activated_prohibitions": {"$ref": "#/$defs/identifiers"},
    "required_evidence_classes": {"$ref": "#/$defs/identifiers"},
    "authority_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "usual_ceiling", "constraints"],
      "properties": {
        "artifact": {"const": "authority-model.yaml"},
        "usual_ceiling": {"type": "string", "minLength": 1},
        "constraints": {"$ref": "#/$defs/strings"}
      }
    },
    "applicable_change_types": {"$ref": "#/$defs/identifiers"},
    "doctrine_artifacts": {"$ref": "#/$defs/strings"},
    "evidence_records": {
      "type": "array",
      "items": {
        "$ref": "https://books.local/doctrine/runtime/evidence-record.schema.json"
      }
    },
    "evidence_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "requirement",
          "required_by",
          "evidence_ids",
          "status"
        ],
        "properties": {
          "obligation_id": {"type": "string", "pattern": "^obl-[0-9a-f]{16}$"},
          "requirement": {"type": "string", "minLength": 1},
          "required_by": {"type": "string", "minLength": 1},
          "evidence_ids": {"$ref": "#/$defs/identifiers"},
          "status": {"enum": ["satisfied", "missing"]}
        }
      }
    },
    "activation_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reasons"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reasons": {"$ref": "#/$defs/strings"}
        }
      }
    },
    "provenance_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept_id", "formulation_ids", "source_support"],
        "properties": {
          "concept_id": {"type": "string", "minLength": 1},
          "formulation_ids": {"$ref": "#/$defs/identifiers"},
          "source_support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "relationship", "locator", "contribution"],
              "properties": {
                "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
                "relationship": {
                  "enum": [
                    "direct_support",
                    "corroboration",
                    "refinement",
                    "derived_inference",
                    "terminology_variant",
                    "historical_precursor",
                    "tension"
                  ]
                },
                "locator": {"type": "string", "minLength": 1},
                "contribution": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "conflicts": {"$ref": "#/$defs/identifiers"},
    "excluded_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "audit_views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formulations", "missing_evidence", "source_locators"],
      "properties": {
        "formulations": {"$ref": "#/$defs/identifiers"},
        "missing_evidence": {"$ref": "#/$defs/strings"},
        "source_locators": {"$ref": "#/$defs/strings"}
      }
    }
  },
  "$defs": {
    "identifiers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retrieval_context": {
            "properties": {"detail": {"const": "full"}}
          }
        }
      },
      "then": {"required": ["audit_views"]},
      "else": {"not": {"required": ["audit_views"]}}
    }
  ]
}
