{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://books.local/doctrine/runtime/evidence-record.schema.json",
  "title": "Typed evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "evidence_class",
    "summary",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "evidence-record/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "evidence_class": {"type": "string", "pattern": "^evidence-[a-z0-9-]+$"},
    "summary": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "satisfies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    }
  }
}
