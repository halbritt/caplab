{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caplab.local/contracts/revbench-v1.schema.json",
  "title": "CAPLAB revbench v1 artifacts",
  "$comment": "Shape validation is necessary but not sufficient. Preparation and scoring also resolve registered references, verify canonical hashes and IDs, require sorted set-like arrays and exactly one control/mutant pair per case, require mutation/oracle/defect pointers to match, prove the control and mutant oracle outcomes, and verify each attested observed Binding against the manifest.",
  "oneOf": [
    {"$ref": "#/$defs/spec"},
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/reviews"},
    {"$ref": "#/$defs/native_review_attempt"},
    {"$ref": "#/$defs/native_attempt_attestation"}
  ],
  "$defs": {
    "json_pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "bounded_capability": {
      "allOf": [
        {"$ref": "qualification-claim-v1.schema.json#/$defs/capability"},
        {
          "properties": {
            "distribution": {"const": "json-integer-minimum/1"}
          },
          "required": ["distribution"]
        }
      ]
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "pointer", "replacement"],
      "properties": {
        "operator": {"const": "replace-json-value/1"},
        "pointer": {"$ref": "#/$defs/json_pointer"},
        "replacement": {"type": "integer"}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pointer", "minimum"],
      "properties": {
        "kind": {"const": "json-integer-minimum/1"},
        "pointer": {"$ref": "#/$defs/json_pointer"},
        "minimum": {"type": "integer"}
      }
    },
    "spec_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "control", "mutation", "oracle", "defect_anchor"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "control": {},
        "mutation": {"$ref": "#/$defs/mutation"},
        "oracle": {"$ref": "#/$defs/oracle"},
        "defect_anchor": {"$ref": "#/$defs/json_pointer"}
      }
    },
    "manifest_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "sha256", "oracle_result"],
      "properties": {
        "content": {},
        "sha256": {"$ref": "qualification-claim-v1.schema.json#/$defs/sha256"},
        "oracle_result": {"type": "boolean"}
      }
    },
    "control_arm": {
      "allOf": [
        {"$ref": "#/$defs/manifest_arm"},
        {
          "properties": {
            "oracle_result": {"const": true}
          },
          "required": ["oracle_result"]
        }
      ]
    },
    "mutant_arm": {
      "allOf": [
        {"$ref": "#/$defs/manifest_arm"},
        {
          "properties": {
            "oracle_result": {"const": false}
          },
          "required": ["oracle_result"]
        }
      ]
    },
    "assignment_order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["control", "mutant"]}
    },
    "manifest_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "assignment_order",
        "control",
        "mutant",
        "mutation",
        "oracle",
        "defect_anchor"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "assignment_order": {"$ref": "#/$defs/assignment_order"},
        "control": {"$ref": "#/$defs/control_arm"},
        "mutant": {"$ref": "#/$defs/mutant_arm"},
        "mutation": {"$ref": "#/$defs/mutation"},
        "oracle": {"$ref": "#/$defs/oracle"},
        "defect_anchor": {"$ref": "#/$defs/json_pointer"}
      }
    },
    "attestation_ref": {
      "allOf": [
        {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
        {
          "properties": {
            "kind": {"const": "native-attempt-attestation"},
            "schema": {"const": "caplab-native-attempt-attestation/1"}
          },
          "required": ["kind", "schema"]
        }
      ]
    },
    "attempt_envelope_ref": {
      "allOf": [
        {"$ref": "qualification-claim-v1.schema.json#/$defs/attempt_ref"},
        {
          "properties": {
            "schema": {"const": "caplab-native-review-attempt/1"}
          },
          "required": ["schema"]
        }
      ]
    },
    "native_system_contract_ref": {
      "allOf": [
        {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
        {
          "properties": {
            "kind": {"const": "native-agent-systems-contract"},
            "schema": {"const": "caplab.native-agent-systems/v1"}
          },
          "required": ["kind", "schema"]
        }
      ]
    },
    "capture_ref": {
      "allOf": [
        {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
        {
          "properties": {
            "kind": {"const": "native-attempt-capture"}
          },
          "required": ["kind"]
        }
      ]
    },
    "basis_authorization_ref": {
      "allOf": [
        {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
        {
          "properties": {
            "kind": {"const": "evidence-basis-authorization"},
            "schema": {"const": "caplab-evidence-basis-authorization/1"}
          },
          "required": ["kind", "schema"]
        }
      ]
    },
    "basis_authorization_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth", "case_selection", "metric_derivation"],
      "properties": {
        "truth": {"$ref": "#/$defs/basis_authorization_ref"},
        "case_selection": {"$ref": "#/$defs/basis_authorization_ref"},
        "metric_derivation": {"$ref": "#/$defs/basis_authorization_ref"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "arm",
        "binding_id",
        "observed_binding",
        "attempt_ref",
        "attestation_ref",
        "prompt_ref",
        "disposition",
        "verdict",
        "anchors",
        "output_ref"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "arm": {"enum": ["control", "mutant"]},
        "binding_id": {"type": "string", "pattern": "^bnd-[0-9a-f]{64}$"},
        "observed_binding": {"$ref": "qualification-claim-v1.schema.json#/$defs/binding"},
        "attempt_ref": {"$ref": "#/$defs/attempt_envelope_ref"},
        "attestation_ref": {"$ref": "#/$defs/attestation_ref"},
        "prompt_ref": {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
        "disposition": {"enum": ["complete", "subject-failure", "infrastructure-failure"]},
        "verdict": {"enum": ["clean", "defect", "invalid"]},
        "anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/json_pointer"},
          "uniqueItems": true
        },
        "output_ref": {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"}
      }
    },
    "native_review_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "experiment_id",
        "case_id",
        "arm",
        "binding_id",
        "observed_binding",
        "attestation_ref",
        "prompt_ref",
        "disposition",
        "verdict",
        "anchors",
        "output_ref",
        "provenance"
      ],
      "properties": {
        "schema_version": {"const": "caplab-native-review-attempt/1"},
        "attempt_id": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
        "experiment_id": {"$ref": "#/$defs/experiment_id"},
        "case_id": {"$ref": "#/$defs/case_id"},
        "arm": {"enum": ["control", "mutant"]},
        "binding_id": {"type": "string", "pattern": "^bnd-[0-9a-f]{64}$"},
        "observed_binding": {"$ref": "qualification-claim-v1.schema.json#/$defs/binding"},
        "attestation_ref": {"$ref": "#/$defs/attestation_ref"},
        "prompt_ref": {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
        "disposition": {"enum": ["complete", "subject-failure", "infrastructure-failure"]},
        "verdict": {"enum": ["clean", "defect", "invalid"]},
        "anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/json_pointer"},
          "uniqueItems": true
        },
        "output_ref": {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
        "provenance": {"$ref": "qualification-claim-v1.schema.json#/$defs/provenance"}
      }
    },
    "native_attempt_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attestation_id",
        "experiment_id",
        "case_id",
        "arm",
        "observed_at",
        "observed_binding",
        "native_system_contract_ref",
        "capture_ref",
        "prompt_ref",
        "output_ref"
      ],
      "properties": {
        "schema_version": {"const": "caplab-native-attempt-attestation/1"},
        "attestation_id": {"type": "string", "pattern": "^attestation-[0-9a-f]{64}$"},
        "experiment_id": {"$ref": "#/$defs/experiment_id"},
        "case_id": {"$ref": "#/$defs/case_id"},
        "arm": {"enum": ["control", "mutant"]},
        "observed_at": {"$ref": "qualification-claim-v1.schema.json#/$defs/utc_timestamp"},
        "observed_binding": {"$ref": "qualification-claim-v1.schema.json#/$defs/binding"},
        "native_system_contract_ref": {"$ref": "#/$defs/native_system_contract_ref"},
        "capture_ref": {"$ref": "#/$defs/capture_ref"},
        "prompt_ref": {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
        "output_ref": {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding",
        "capability",
        "protocol",
        "corpus",
        "case_selection_ref",
        "basis_authorization_refs",
        "cases",
        "provenance"
      ],
      "properties": {
        "schema_version": {"const": "caplab-revbench-spec/1"},
        "binding": {"$ref": "qualification-claim-v1.schema.json#/$defs/binding"},
        "capability": {"$ref": "#/$defs/bounded_capability"},
        "protocol": {"$ref": "qualification-claim-v1.schema.json#/$defs/protocol_ref"},
        "corpus": {"$ref": "qualification-claim-v1.schema.json#/$defs/corpus_ref"},
        "case_selection_ref": {"$ref": "qualification-claim-v1.schema.json#/$defs/case_selection_ref"},
        "basis_authorization_refs": {"$ref": "#/$defs/basis_authorization_refs"},
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/spec_case"},
          "uniqueItems": true
        },
        "provenance": {"$ref": "qualification-claim-v1.schema.json#/$defs/provenance"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "family",
        "family_version",
        "binding",
        "capability",
        "protocol",
        "corpus",
        "case_selection_ref",
        "basis_authorization_refs",
        "cases",
        "provenance"
      ],
      "properties": {
        "schema_version": {"const": "caplab-revbench-manifest/1"},
        "experiment_id": {"$ref": "#/$defs/experiment_id"},
        "family": {"const": "revbench"},
        "family_version": {"const": "1"},
        "binding": {"$ref": "qualification-claim-v1.schema.json#/$defs/binding"},
        "capability": {"$ref": "#/$defs/bounded_capability"},
        "protocol": {"$ref": "qualification-claim-v1.schema.json#/$defs/protocol_ref"},
        "corpus": {"$ref": "qualification-claim-v1.schema.json#/$defs/corpus_ref"},
        "case_selection_ref": {"$ref": "qualification-claim-v1.schema.json#/$defs/case_selection_ref"},
        "basis_authorization_refs": {"$ref": "#/$defs/basis_authorization_refs"},
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/manifest_case"},
          "uniqueItems": true
        },
        "provenance": {"$ref": "qualification-claim-v1.schema.json#/$defs/provenance"}
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "experiment_id", "observed_at", "attempts"],
      "properties": {
        "schema_version": {"const": "caplab-revbench-reviews/1"},
        "experiment_id": {"$ref": "#/$defs/experiment_id"},
        "observed_at": {"$ref": "qualification-claim-v1.schema.json#/$defs/utc_timestamp"},
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/attempt"},
          "uniqueItems": true
        }
      }
    }
  }
}
