            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "expected_behavior": {
            "type": "string"
          },
          "observed_or_predicted_behavior": {
            "type": "string"
          },
          "change_attribution": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "claim_status": {
