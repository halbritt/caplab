{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caplab.local/contracts/qualification-export-v1.schema.json",
  "title": "CAPLAB qualification claim export v1",
  "$comment": "Shape validation is necessary but not sufficient; caplab-qualification-contract-v1.md defines mandatory semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "selection",
    "schemas",
    "claims",
    "producer"
  ],
  "properties": {
    "schema_version": {"const": "caplab-qualification-export/1"},
    "export_id": {"type": "string", "pattern": "^export-[0-9a-f]{64}$"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "capability"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^bnd-[0-9a-f]{64}$"},
        "capability": {"$ref": "qualification-claim-v1.schema.json#/$defs/capability"}
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "export"],
      "properties": {
        "claim": {"$ref": "#/$defs/schema_ref"},
        "export": {"$ref": "#/$defs/schema_ref"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "qualification-claim-v1.schema.json"}
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "commit", "package_sha256"],
      "properties": {
        "product": {"const": "caplab"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "schema_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sha256"],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
