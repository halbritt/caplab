{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caplab.local/contracts/qualification-records-v1.schema.json",
  "title": "CAPLAB qualification records v1",
  "$comment": "Shape validation is necessary but not sufficient; caplab-qualification-contract-v1.md defines mandatory canonical ordering, content-ID, cross-record, sample-flow, evidence-registration, authority, and policy-evaluation checks.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "qualification-claim-v1.schema.json#/$defs/binding"
    },
    {
      "$ref": "#/$defs/measurement"
    },
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/case_selection"
    },
    {
      "$ref": "#/$defs/basis_authorization"
    },
    {
      "$ref": "qualification-claim-v1.schema.json#/$defs/authorization"
    },
    {
      "$ref": "#/$defs/authorization_delegation"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "measurement_id",
        "observed_at",
        "binding",
        "capability",
        "experiment",
        "protocol",
        "corpus",
        "evidence_basis",
        "disposition",
        "sample_flow",
        "metrics",
        "evidence",
        "covariates",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "caplab-measurement/1"
        },
        "measurement_id": {
          "type": "string",
          "pattern": "^meas-[0-9a-f]{64}$"
        },
        "observed_at": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/utc_timestamp"
        },
        "binding": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/binding"
        },
        "capability": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/capability"
        },
        "experiment": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/experiment"
        },
        "protocol": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/protocol_ref"
        },
        "corpus": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/corpus_ref"
        },
        "evidence_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_basis"
          },
          "uniqueItems": true
        },
        "disposition": {
          "enum": [
            "complete",
            "incomplete",
            "invalid",
            "infrastructure-failure"
          ]
        },
        "sample_flow": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/sample_flow"
        },
        "metrics": {
          "$ref": "#/$defs/measurement_metrics"
        },
        "evidence": {
          "$ref": "#/$defs/measurement_evidence"
        },
        "covariates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/covariate"
          },
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/provenance"
        }
      }
    },
    "case_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "selection_id",
        "population_ref",
        "included_case_refs",
        "excluded_case_refs",
        "selection_inputs",
        "exclusion_inputs",
        "conditioned_on",
        "authorization_ref"
      ],
      "properties": {
        "schema_version": {
          "const": "caplab-case-selection-manifest/1"
        },
        "selection_id": {
          "type": "string",
          "pattern": "^selection-[0-9a-f]{64}$"
        },
        "population_ref": {
          "allOf": [
            {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
            {"properties": {"kind": {"const": "case-population"}}}
          ]
        },
        "included_case_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
              {"properties": {"kind": {"const": "case"}}}
            ]
          },
          "uniqueItems": true
        },
        "excluded_case_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
              {"properties": {"kind": {"const": "case"}}}
            ]
          },
          "uniqueItems": true
        },
        "selection_inputs": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
              {"properties": {"kind": {"const": "case-selection-input"}}}
            ]
          },
          "uniqueItems": true
        },
        "exclusion_inputs": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"},
              {"properties": {"kind": {"const": "case-selection-input"}}}
            ]
          },
          "uniqueItems": true
        },
        "conditioned_on": {
          "type": "array",
          "items": {
            "enum": [
              "downstream_fate",
              "model_judgment",
              "human_judgment",
              "provider_verdict",
              "scheduler_choice",
              "admission",
              "backend_rank",
              "task_difficulty",
              "attempt_outcome"
            ]
          },
          "uniqueItems": true
        },
        "authorization_ref": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/authorization_delegation_ref"
        }
      }
    },
    "basis_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authorization_id",
        "authority_source_ref",
        "authorized_by",
        "delegate_or_mechanism",
        "binding_ids",
        "capability",
        "experiment",
        "protocol_ref",
        "corpus_ref",
        "case_selection_ref",
        "method_ref",
        "basis_kind",
        "basis_role",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "schema_version": {
          "const": "caplab-evidence-basis-authorization/1"
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^basis-auth-[0-9a-f]{64}$"
        },
        "authority_source_ref": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/authorization_delegation_ref"
        },
        "authorized_by": {
          "type": "string",
          "minLength": 1
        },
        "delegate_or_mechanism": {
          "type": "string",
          "minLength": 1
        },
        "binding_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^bnd-[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "capability": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/capability"
        },
        "experiment": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/experiment"
        },
        "protocol_ref": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/protocol_ref"
        },
        "corpus_ref": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/corpus_ref"
        },
        "case_selection_ref": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/case_selection_ref"
        },
        "method_ref": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"
        },
        "basis_kind": {
          "enum": [
            "mechanical-oracle",
            "human-authorized",
            "model-judgment"
          ]
        },
        "basis_role": {
          "enum": [
            "truth",
            "case-selection",
            "metric-derivation"
          ]
        },
        "valid_from": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/utc_timestamp"
        },
        "valid_until": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/utc_timestamp"
        }
      }
    },
    "measurement_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_ref",
        "run_refs"
      ],
      "properties": {
        "bundle_ref": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/evidence_bundle_ref"
        },
        "run_refs": {
          "type": "array",
          "items": {
            "$ref": "qualification-claim-v1.schema.json#/$defs/attempt_ref"
          },
          "uniqueItems": true
        }
      }
    },
    "covariate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "evidence_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "value": {
          "$ref": "#/$defs/canonical_json_scalar"
        },
        "evidence_ref": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "downstream_fate"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "name",
        "version",
        "capability",
        "applies_to",
        "requirements",
        "criteria",
        "outcomes",
        "authority",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "caplab-qualification-policy/1"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^pol-[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/capability"
        },
        "applies_to": {
          "$ref": "#/$defs/policy_scope"
        },
        "requirements": {
          "$ref": "#/$defs/policy_requirements"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/policy_criterion"
          },
          "uniqueItems": true
        },
        "outcomes": {
          "$ref": "#/$defs/policy_outcomes"
        },
        "authority": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "qualification-claim-v1.schema.json#/$defs/authorization"
            }
          ]
        },
        "provenance": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/provenance"
        }
      }
    },
    "policy_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "protocol_sha256",
        "corpus_sha256",
        "binding_resolutions"
      ],
      "properties": {
        "experiment": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/experiment"
        },
        "protocol_sha256": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/sha256"
        },
        "corpus_sha256": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/sha256"
        },
        "binding_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "immutable",
              "observed-route"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "policy_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_usable",
        "maximum_missing_rate",
        "maximum_infrastructure_failure_rate",
        "basis_kinds"
      ],
      "properties": {
        "minimum_usable": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_missing_rate": {
          "$ref": "#/$defs/rate"
        },
        "maximum_infrastructure_failure_rate": {
          "$ref": "#/$defs/rate"
        },
        "basis_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "mechanical-oracle",
              "human-authorized"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "policy_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "operator",
        "threshold"
      ],
      "properties": {
        "metric": {
          "$ref": "#/$defs/metric_name"
        },
        "operator": {
          "enum": [
            "metric_at_least",
            "metric_at_most"
          ]
        },
        "threshold": {
          "$ref": "qualification-claim-v1.schema.json#/$defs/ratio"
        }
      }
    },
    "metric_name": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        {
          "not": {
            "pattern": "fate|outcome|admission|provider[._-]?verdict|scheduler[._-]?choice|backend[._-]?rank"
          }
        }
      ]
    },
    "policy_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "met",
        "not_met",
        "insufficient",
        "no_measurement"
      ],
      "properties": {
        "met": {
          "const": "qualified"
        },
        "not_met": {
          "const": "unqualified"
        },
        "insufficient": {
          "const": "advisory"
        },
        "no_measurement": {
          "const": "unmeasured"
        }
      }
    },
    "evidence_basis": {
      "allOf": [
        {
          "$ref": "qualification-claim-v1.schema.json#/$defs/basis_summary"
        },
        {
          "properties": {
            "authorization_ref": {
              "allOf": [
                {
                  "$ref": "qualification-claim-v1.schema.json#/$defs/content_ref"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "evidence-basis-authorization"
                    },
                    "schema": {
                      "const": "caplab-evidence-basis-authorization/1"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "measurement_metrics": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/metric_name"
      },
      "additionalProperties": {
        "$ref": "qualification-claim-v1.schema.json#/$defs/metric"
      }
    },
    "rate": {
      "allOf": [
        {
          "$ref": "qualification-claim-v1.schema.json#/$defs/ratio"
        },
        {
          "properties": {
            "numerator": {
              "minimum": 0
            }
          }
        }
      ]
    },
    "authorization_delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "delegation_id",
        "effect",
        "authorized_by",
        "delegate_or_mechanism",
        "scope",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "schema_version": {"const": "caplab-authorization-delegation/1"},
        "delegation_id": {"type": "string", "pattern": "^delegation-[0-9a-f]{64}$"},
        "effect": {
          "enum": [
            "case-selection",
            "evidence-basis",
            "qualification",
            "revbench-execution"
          ]
        },
        "authorized_by": {"type": "string", "minLength": 1},
        "delegate_or_mechanism": {"type": "string", "minLength": 1},
        "scope": {"type": "object", "minProperties": 1},
        "valid_from": {"$ref": "qualification-claim-v1.schema.json#/$defs/utc_timestamp"},
        "valid_until": {"$ref": "qualification-claim-v1.schema.json#/$defs/utc_timestamp"}
      }
    },
    "canonical_json_scalar": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    }
  }
}
