  "findings": [
    "Base loses actual displayed publication dates and admits known stale/future RSS items; repair preserves dates and filters those items.",
    "Base admits known future instants; repair enforces the upper window bound.",
    "Base labels a non-UTC time as UTC, shifting the displayed instant; repair preserves its offset.",
    "Repair expands tilde history paths to private home; default path behavior is preserved."
  ],
  "limits": [
    "Pinned installed producer reports modified source; no verified historical deployed-binary identity.",
    "No editor/model execution or freshness judgment on unknown dates.",
    "Date-overlap candidates are not proof of exact publication within the 24-hour window.",
    "Development evidence only; no case admission, scorer acceptance or reviewer ranking.",
    "No prior tilde-expansion policy is established; path resolution is a verified compatibility behavior.",
    "Multiple mechanisms within one sampled change do not become independent cases."
  ],
